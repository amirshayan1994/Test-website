---
const year = new Date().getFullYear();
const socials = [
  { href: 'https://github.com/', label: 'گیت‌هاب' },
  { href: 'https://linkedin.com/', label: 'لینکدین' },
  { href: 'mailto:hello@example.com', label: 'ایمیل' },
];
---

<footer class="border-t border-ink-800/60 mt-24">
  <div class="mx-auto flex max-w-4xl flex-col items-center justify-between gap-4 px-6 py-8 text-sm text-ink-400 sm:flex-row">
    <p>© {year} — ساخته‌شده با Astro</p>
    <ul class="flex items-center gap-5">
      {
        socials.map((s) => (
          <li>
            <a href={s.href} target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent">
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
